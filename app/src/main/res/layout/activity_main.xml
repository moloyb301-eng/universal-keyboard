<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/statusBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/statusDot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="8dp"
                android:text="●"
                android:textColor="@color/status_wait"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Starting…"
                android:textColor="@color/text"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnPair"
            style="@style/TopButton"
            android:text="Pair" />

        <Button
            android:id="@+id/btnHosts"
            style="@style/TopButton"
            android:text="Hosts" />

        <Button
            android:id="@+id/btnKeyboard"
            style="@style/TopButton"
            android:contentDescription="Show or hide keyboard"
            android:text="⌨" />

        <Button
            android:id="@+id/btnSettings"
            style="@style/TopButton"
            android:contentDescription="Settings"
            android:text="⚙" />
    </LinearLayout>

    <com.universalkeyboard.ui.TrackpadView
        android:id="@+id/trackpad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnLeft"
            style="@style/MouseButton"
            android:layout_marginEnd="3dp"
            android:text="Left click" />

        <Button
            android:id="@+id/btnRight"
            style="@style/MouseButton"
            android:layout_marginStart="3dp"
            android:text="Right click" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/shortcutRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <com.universalkeyboard.input.KeyCaptureView
        android:id="@+id/keyCapture"
        android:layout_width="1dp"
        android:layout_height="1dp" />
</LinearLayout>
