<?xml version="1.0" encoding="utf-8"?>
<!--
    Everything stays HTTPS-only (updates come from GitHub over HTTPS), except the
    Claude bridge, which runs on this phone and is reached at ws://127.0.0.1.
    Loopback traffic never leaves the device, and the bridge checks a pairing code.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
